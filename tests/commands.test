} -result 2f02e24ae2e1fe880399f27600afa88364e6062bf9bbe114b32fa8f23d03608a

test hex-case {Encoder uses lowercase and decoder accepts either case} -body {
    list [::thashlib::hex_encode [binary decode hex 00aaff]] [binary encode hex [::thashlib::hex_decode 00aAfF]]
} -result {00aaff 00aaff}
test hex-empty {Empty conversions} -body {
    list [::thashlib::hex_encode {}] [::thashlib::hex_decode {}]
} -result {{} {}}
test hex-roundtrip {Every byte survives a hex round trip} -body {
    set bytes [binary format cu* [lmap i [lrepeat 256 {}] {incr n}]]
    expr {[::thashlib::hex_decode [::thashlib::hex_encode $bytes]] eq $bytes}
} -setup {set n -1} -result 1
foreach value [list 0 000 GG {00 11} 00:11 "00\x0011" "\x00\x00" 雪😀] {
    test hex-invalid-[binary encode hex [encoding convertto utf-8 $value]] {Reject malformed hex} -body {
        ::thashlib::hex_decode $value
    } -returnCodes error -errorCode {THASHLIB HEX} -result {expected an even number of hexadecimal digits}
}
foreach length {0 1 32 4096} {
    test random-length-$length {Requested byte count is returned} -body {
        string length [::thashlib::random_bytes $length]
    } -result $length
}
foreach value {-1 1.5 abc 999999999999999999999999999999999999} {
    test random-invalid-$value {Reject invalid lengths} -body {
        ::thashlib::random_bytes $value
    } -returnCodes error -errorCode {THASHLIB LENGTH} -match glob -result {num_bytes must be an integer >= 0*}
}
foreach command {md5 sha1 sha256 sha512 hex_encode hex_decode random_bytes hmac_sha256} {
    test arity-$command {Reject wrong argument counts} -body {
        list [catch {::thashlib::$command}] [catch {::thashlib::$command a b c}]
    } -result {1 1}
}
test text-encoding {Explicit UTF-8 bytes have stable digests} -body {
    ::thashlib::hex_encode [::thashlib::sha256 [encoding convertto utf-8 "雪😀"]]
} -result c7d6344b3b16cb73d55e41f1bf3ec5e71eafcf3296b3eb41e8f9e776e7d5bd45
